# FinAlly environment variables.
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# .env is gitignored and is passed to the container via env_file / --env-file.

# OpenRouter API key, used for the AI chat assistant.
# Required unless LLM_MOCK=true. Get one at https://openrouter.ai/keys
# Default: (none - chat fails without it)
OPENROUTER_API_KEY=

# Massive (Polygon.io) API key for real market data.
# Leave empty to use the built-in market simulator, which is the
# recommended setting for local use and for tests.
# Default: (empty -> simulator)
MASSIVE_API_KEY=

# Return deterministic mock LLM responses instead of calling OpenRouter.
# Set to "true" for E2E tests, CI, or development without an API key.
# Default: false
LLM_MOCK=false

# Backend log level: DEBUG, INFO, WARNING, ERROR or CRITICAL (case-insensitive).
# Anything else falls back to INFO. DEBUG adds a per-poll line from the Massive
# poller every 15s. Shows up in: docker compose logs -f
# Default: INFO
LOG_LEVEL=INFO

# Path to the SQLite database file.
# Inside the container this must stay under /app/db, which is the mount point
# for the finally-data volume, so the data survives a rebuild.
# docker-compose.yml already sets this; you only need it for local (non-Docker)
# runs, where db/finally.db relative to the project root is the default.
# Default: db/finally.db
DB_PATH=/app/db/finally.db
